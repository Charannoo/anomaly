# PNTC AI Assistant Environment Configuration (Example)
# Copy this file to .env and insert your private API keys.
# NEVER commit .env to version control or expose keys in frontend code.

# Primary Provider: Google Gemini
GEMINI_API_KEY=

# Optional Secondary Provider: xAI Grok
XAI_API_KEY=

# Configured Provider: 'gemini' or 'grok' (default: 'gemini')
PNTC_LLM_PROVIDER=gemini

# Model Overrides (Optional - defaults: gemini-2.5-flash / grok-2-latest)
PNTC_LLM_MODEL=
PNTC_LLM_TEMPERATURE=0.1
